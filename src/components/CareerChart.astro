---
// Career timeline chart — bar positions as percentages of the design's 964px
// chart width (2018 → now), so it scales with the column instead of overflowing.
// Bars double as tabs: selecting one reveals its role in the experience list.
const TOTAL = 964;

const pct = (px: number) => `${((px / TOTAL) * 100).toFixed(4)}%`;

const bars = [
	{ label: "Bigio.id", x: 0, w: 107, tone: "mid", role: 5 },
	{ label: "Rolling Glory", x: 111, w: 217, tone: "ft", role: 4 },
	{ label: "Argapro", x: 330, w: 107, tone: "mid", role: 3 },
	{ label: "Cakap", x: 440, w: 326, tone: "ft", role: 2 },
	{ label: "career break", x: 768, w: 107, tone: "break", role: 1 },
	{ label: "NTT · now", x: 877, w: 87, tone: "now", role: 0 },
] as const;

const ticks = [
	{ year: "2018", x: 0 },
	{ year: "2019", x: 109 },
	{ year: "2020", x: 219 },
	{ year: "2021", x: 328 },
	{ year: "2022", x: 438 },
	{ year: "2023", x: 547 },
	{ year: "2024", x: 657 },
	{ year: "2025", x: 766 },
	{ year: "2026", x: 875 },
] as const;
---

<div class="chart" role="tablist" aria-label="Career timeline" data-career-tabs>
	{
		bars.map((bar) => (
			<button
				type="button"
				class:list={["bar", `bar-${bar.tone}`]}
				style={`left: ${pct(bar.x)}; width: ${pct(bar.w)};`}
				role="tab"
				id={`role-tab-${bar.role}`}
				aria-controls={`role-panel-${bar.role}`}
				aria-selected={bar.role === 0 ? "true" : "false"}
				tabindex={bar.role === 0 ? 0 : -1}
				data-role-index={bar.role}
			>
				<span>{bar.label}</span>
			</button>
		))
	}
	<div class="tick-group" aria-hidden="true">
		{
			ticks.map((tick) => (
				<>
					<div class="tick" style={`left: ${pct(tick.x)};`} />
					<span class="year" style={`left: calc(${pct(tick.x)} + 8px);`}>
						{tick.year}
					</span>
				</>
			))
		}
		<div class="tick tick-now"></div>
		<span class="year year-now">now</span>
	</div>
</div>

<style>
	.chart {
		position: relative;
		width: 100%;
		max-width: 964px;
		height: 58px;
	}

	.bar {
		position: absolute;
		top: 0;
		height: 30px;
		display: flex;
		align-items: center;
		justify-content: center;
		overflow: hidden;
		border: none;
		border-radius: 3px;
		padding: 0;
		cursor: pointer;
		font-family: var(--font-mono);
		font-size: 11px;
		line-height: 1.3;
		white-space: nowrap;
		transition:
			box-shadow 150ms ease,
			filter 150ms ease;
	}

	@media (hover: hover) {
		.bar:hover {
			filter: brightness(1.08);
		}
	}

	.bar[aria-selected="true"] {
		box-shadow:
			0 0 0 2px var(--color-bg),
			0 0 0 4px var(--color-accent-deep);
	}

	.bar-ft {
		background: var(--color-accent);
		color: var(--color-cream);
	}

	.bar-mid {
		background: var(--color-accent-mid);
		color: var(--color-cream);
	}

	.bar-break {
		background: var(--color-accent-break);
		color: var(--color-ink);
	}

	.bar-now {
		background: var(--color-accent-deep);
		color: var(--color-accent-bright);
	}

	.tick-group {
		position: absolute;
		inset: 0;
		pointer-events: none;
	}

	.tick {
		position: absolute;
		top: 34px;
		width: 1px;
		height: 20px;
		background: var(--color-border);
	}

	.tick-now {
		left: calc(100% - 1.5px);
		width: 1.5px;
		background: var(--color-accent);
	}

	.year {
		position: absolute;
		top: 40px;
		font-family: var(--font-mono);
		font-size: 11px;
		line-height: 1.2;
		color: var(--color-text-muted);
		white-space: nowrap;
	}

	.year-now {
		right: 8px;
		text-align: right;
		font-weight: 600;
		color: var(--color-accent);
	}

	@media (max-width: 720px) {
		/* Keep the accessible name: clip visually instead of removing the label */
		.bar span {
			position: absolute;
			width: 1px;
			height: 1px;
			padding: 0;
			margin: -1px;
			overflow: hidden;
			clip-path: inset(50%);
			white-space: nowrap;
		}
	}
</style>

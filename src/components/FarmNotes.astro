---
import { getCollection } from "astro:content";
import NoteList from "./NoteList.astro";
import { formatDayMonth } from "../utils/dates";

const farmNotes = await getCollection(
	"notes",
	(note) => note.data.section === "farm" && !note.data.draft,
);

const sorted = farmNotes.sort((a, b) => +b.data.date - +a.data.date);

const years = [...new Set(sorted.map((note) => note.data.date.getFullYear()))];

const byYear = years.map((year) => ({
	year,
	notes: sorted
		.filter((note) => note.data.date.getFullYear() === year)
		.map((note) => ({
			slug: note.id,
			date: formatDayMonth(note.data.date),
			title: note.data.title,
			tag: note.data.tag,
			warm: note.data.warm,
			read: note.data.readTime,
		})),
}));
---

<section
	class="farm-notes"
	id="farm-notes"
	aria-labelledby="farm-notes-heading"
>
	<header class="section-head">
		<h2 class="section-label" id="farm-notes-heading">
			farm notes — writing about the process
		</h2>
		<hr class="rule-ink" />
	</header>

	{byYear.length === 0 ? (
		<p class="empty">nothing published yet — coming soon</p>
	) : (
		byYear.map(({ year, notes }) => (
			<>
				<p class="year">{year}</p>
				<NoteList notes={notes} tagWidth={96} />
			</>
		))
	)}
</section>

<style>
	.farm-notes {
		display: flex;
		flex-direction: column;
		gap: 20px;
	}

	.year {
		font-family: var(--font-mono);
		font-size: 0.75rem;
		line-height: 1.3;
		color: var(--color-text-muted);
	}

	.empty {
		padding: 22px 0;
		border-top: 1px solid var(--color-border);
		font-family: var(--font-mono);
		font-size: 0.75rem;
		line-height: 1.5;
		color: var(--color-text-muted);
	}

	@media (max-width: 960px) {
		.year {
			font-size: 0.6875rem;
		}
	}
</style>

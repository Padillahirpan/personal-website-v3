---
import Icon from "./Icon.astro";
---

<a class="email-btn" href="mailto:padillahirpan@gmail.com">
	<Icon name="mail" size={16} />
	<span>padillahirpan@gmail.com</span>
</a>

<style>
	.email-btn {
		display: inline-flex;
		align-items: center;
		gap: 10px;
		padding: 12px 20px;
		border-radius: 12px;
		background: var(--color-accent-deep);
		color: var(--color-cream);
		font-family: var(--font-mono);
		font-size: 0.84375rem;
		line-height: 1.3;
		transition: background-color 150ms ease;
	}

	.email-btn :global(svg) {
		color: var(--color-accent-bright);
	}

	@media (hover: hover) {
		.email-btn:hover {
			background: var(--color-accent-panel);
		}
	}

	@media (prefers-reduced-motion: no-preference) {
		.email-btn {
			transition:
				background-color 150ms ease,
				scale 150ms ease-out;
		}

		.email-btn:active {
			scale: 0.96;
		}
	}

	/* Mobile composition (from the pen mobile frames) */
	@media (max-width: 960px) {
		.email-btn {
			gap: 8px;
			padding: 11px 16px;
			border-radius: 10px;
			font-size: 0.78125rem;
		}

		.email-btn :global(svg) {
			width: 14px;
			height: 14px;
		}
	}
</style>

---
import Base from "../layouts/Base.astro";
import Page from "../layouts/Page.astro";
import FarmNotes from "../components/FarmNotes.astro";
import FarmPhotos from "../components/FarmPhotos.astro";
import Greenhouse from "../components/Greenhouse.astro";
import EmailButton from "../components/EmailButton.astro";
---

<Base
	title="The Farm — Irpan"
	description="Why Irpan started farming hydroponic NFT lettuce — the story, the notes, and the bamboo greenhouse behind Selada Ops."
>
	<Page active="farm" mainGap={56} padBottom={88}>
		<header class="intro">
			<h1 class="farm-heading">The Farm.</h1>
			<p class="farm-sub">
				Why I started farming hydroponic NFT lettuce — the story, the notes,
				and the greenhouse.
			</p>
			<p class="farm-bio">
				It started during the 2025 career break. After years of sprinting on
				software, I wanted something slow and physical to balance the screens
				— and I wanted to know exactly where my food comes from. Lettuce was
				the obvious first crop: fast, forgiving, and ready in 30–45 days.
			</p>
			<p class="farm-bio">
				The engineer in me picked NFT — Nutrient Film Technique — on purpose.
				It is a circulating system with measurable inputs: EC, pH, water
				temperature, flow. If it isn’t measured, it isn’t farming, it’s
				guessing. So I built a small bamboo greenhouse, ran six channels off a
				single pump, and started logging everything. Ten months later, the
				garden feeds my family and half the neighborhood.
			</p>

			<ul class="chips" aria-label="Farm stats">
				<li>10 months growing</li>
				<li>12 harvest cycles</li>
				<li>~90% less water</li>
				<li>0 soil</li>
			</ul>
		</header>

		<FarmNotes />
		<FarmPhotos />
		<Greenhouse />

		<section class="closing" aria-labelledby="closing-heading">
			<h2 class="closing-heading" id="closing-heading">
				Come see it — or start your own.
			</h2>
			<p class="closing-text">
				The garden gate is open to fellow engineers-turned-farmers, school
				visits, and anyone curious about growing greens in a small space.
			</p>
			<div class="closing-cta">
				<EmailButton />
				<p class="closing-meta">
					new notes monthly — see
					<a href="#farm-notes">farm notes ↑</a>
				</p>
			</div>
		</section>
	</Page>
</Base>

<style>
	.intro {
		display: flex;
		flex-direction: column;
		gap: 18px;
	}

	.farm-heading {
		font-family: var(--font-display);
		font-size: clamp(2rem, 3.1944vw, 2.875rem);
		font-weight: 600;
		line-height: 1.2;
		color: var(--color-ink);
	}

	.farm-sub {
		font-family: var(--font-display);
		font-size: 1.1875rem;
		line-height: 1.5;
		color: var(--color-text-muted);
	}

	.farm-bio {
		font-family: var(--font-display);
		font-size: 1.1875rem;
		line-height: 1.7;
		color: var(--color-text-body);
	}

	.chips {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-wrap: wrap;
		gap: 12px;
	}

	.chips li {
		padding: 8px 14px;
		border-radius: 999px;
		background: var(--color-accent-soft);
		color: var(--color-accent);
		font-family: var(--font-mono);
		font-size: 0.78125rem;
		line-height: 1.3;
		white-space: nowrap;
	}

	.closing {
		display: flex;
		flex-direction: column;
		gap: 16px;
	}

	.closing-heading {
		font-family: var(--font-display);
		font-size: clamp(1.5rem, 2.0833vw, 1.875rem);
		font-weight: 600;
		line-height: 1.2;
		color: var(--color-ink);
	}

	.closing-text {
		max-width: 35rem;
		font-size: 0.96875rem;
		line-height: 1.6;
		color: var(--color-text-muted);
	}

	.closing-cta {
		display: flex;
		align-items: center;
		flex-wrap: wrap;
		gap: 12px 16px;
	}

	.closing-meta {
		font-family: var(--font-mono);
		font-size: 0.75rem;
		line-height: 1.3;
		color: var(--color-text-muted);
	}

	.closing-meta a {
		color: inherit;
		transition: color 150ms ease;
	}

	@media (hover: hover) {
		.closing-meta a:hover {
			color: var(--color-accent);
		}
	}
</style>
